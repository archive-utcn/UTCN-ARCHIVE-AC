$WAVE4
$RESOLUTION 1000
$ENDTIME 400000
I 1 "a#22#BIT_VECTOR(3 downto 0)1 ricd3 0 e#3#bitc2 01"
I 2 "e#3#bitc2 01"
$BUS IN 1 1 4 A_ROM
$SC 2-5
$IN 6 2 CS_ROM
I 3 "a#22#BIT_VECTOR(7 downto 0)1 ricd7 0 e#3#bitc2 01"
$BUS OUT 7 3 8 D_ROM
$SC 8-+7
P 0 1-15 CS "0"
P 0 2 Stimulator "KEY:KEY:Override:65/0,1:A:1:"
P 0 6 Stimulator "KEY:KEY:Override:67/0,1:C:1:"
P 0 4 Stimulator "KEY:KEY:Override:68/0,1:D:1:"
P 0 5 Stimulator "KEY:KEY:Override:70/0,1:F:1:"
