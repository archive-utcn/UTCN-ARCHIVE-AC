$WAVE4TIMED
$RESOLUTION 1000
$ENDTIME 100000
I 1 "a#25#BIT_VECTOR(1 to input_nr)1 rict1 2 e#3#bitc2 01"
I 2 "e#3#bitc2 01"
$BUS IN 9 1 2 input
$SC 1 5
$OUT +5 2 y
$ENDTIME 200000
$WAVES 5
=0 T 100k
$VALUES
V 1
0
$END
$WAVES 1
*0
=1 D 0 1
$VALUES
V 2
0
1
$END
$WAVES +9
*0
=2 D 0 2
$VALUES
V 2
0
1
$END
$ENDTIME 300000
$ENDTIME 400000
$WAVES 1
=3 D 300k 1
$VALUES
V 1
0
$END
$WAVES +9
=4 D 300k 2
$VALUES
V 1
0
$END
$ENDTIME 500000
$ENDWAVE
