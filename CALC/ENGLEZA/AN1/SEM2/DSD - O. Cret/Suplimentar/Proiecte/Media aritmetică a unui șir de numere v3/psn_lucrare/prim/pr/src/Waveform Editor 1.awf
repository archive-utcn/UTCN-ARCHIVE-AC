$WAVE4
$RESOLUTION 1000
$ENDTIME 300000
I 1 "e#3#bitc2 01"
$IN 1 1 A
$IN 2 1 B
$OUT 3 1 Y
P 0 1-3 CS "0"
P 0 1 Stimulator "KEY:KEY:Override:65/0,1:A:1:"
P 0 2 Stimulator "KEY:KEY:Override:66/0,1:B:1:"
$WAVES 1
=0 T 0
=1 D 200k 1
$VALUES
V 1
0
V 1
1
$END
$WAVES 2
*0
=2 D 100k 1
$VALUES
V 1
0
V 1
1
$END
$WAVES 3
*0
=3 D 200k 2
$VALUES
V 1
0
V 1
1
$END
$ENDWAVE
