     16				     P1: MOV CX, 0FF00H;loads cx with 0FF00h
     17					  ;counts
     18				     P2: DEC CX	 ;;delays by decrementing cx
     19				      JNZ P2  ;;if cx!=0 continue
     20				      DEC DX  ;;if cx=0	decrements dx
     21				      JNZ P1  ;;if dx!=0 loads again cx
     22				      POP  CX  ;;if dx=0 remake	cx and dx
     23				      POP  DX  ;;
     24				      ENDM   ;;end macro
